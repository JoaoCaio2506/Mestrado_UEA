# Production URL of the n8n Webhook node that receives the chat message +
# uploaded image (multipart/form-data: chatInput, sessionId, file) for the
# Mestrado_UEA workflow. Copy this file to .env and fill it in — .env is
# gitignored so the real URL never gets committed.
#
# Leave empty to keep using the local simulated diagnosis response instead
# of calling n8n.
VITE_N8N_WEBHOOK_URL=

# URL of the Grad-CAM API (multipart/form-data field "file", returns a PNG).
# Leave empty to skip it — the plain uploaded image is used instead.
VITE_GRADCAM_URL=
